{
  "compilerOptions": {
    "target": "ESNext",
    "module": "esnext",
    "lib": ["esnext", "dom"],
    "rootDir": "./src",
    "outDir": "./lib-ts",
    "sourceMap": true,
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "strict": false,
    "alwaysStrict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": false,
    "noUnusedLocals": false, //未使用変数でエラーを出さない
    "noUnusedParameters": false,
    "preserveConstEnums": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
